# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env asla sürüm kontrolüne eklenmez, izni 600 olmalıdır.

NODE_ENV=production
PORT=8080
APP_URL=https://portal.terayatirim.com.tr
TRUST_PROXY=true

# --- Veritabanı (PostgreSQL 14+) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tera_portal
DB_USER=tera_portal
DB_PASSWORD=BURAYA_GUCLU_PAROLA
DB_SSL=false

# --- Kimlik doğrulama ---
# 'ldap' -> gerçek Active Directory (üretimde zorunlu). 'mock' yalnızca geliştirme/test.
AUTH_MODE=ldap
LDAP_URL=ldaps://dc01.tera.local:636
LDAP_BASE_DN=DC=tera,DC=local
LDAP_BIND_DN=CN=svc-portal,OU=ServisHesaplari,DC=tera,DC=local
# Servis hesabı parolası .env'e YAZILMAZ — uygulama açıldıktan sonra
# Admin Panel > Dizin (AD) Ayarları ekranından girilir, şifreli saklanır.

# --- Oturum ---
SESSION_COOKIE=tp_sid
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_MIN=600
LOGIN_MAX_ATTEMPTS=8

# SMTP/AD parolalarını veritabanında şifrelemek için 32 bayt base64 anahtar:
#   openssl rand -base64 32
# Bu anahtar kaybolursa kayıtlı parolalar çözülemez, ekrandan yeniden girilir.
APP_ENCRYPTION_KEY=BURAYA_32_BAYT_BASE64_ANAHTAR

# --- Dosya yükleme ---
UPLOAD_DIR=/var/lib/tera-portal/uploads
UPLOAD_MAX_MB=25

# --- İş kuralları ---
READING_SECONDS_PER_PAGE=30
QUIZ_PASS_SCORE=70
