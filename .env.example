# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env asla sürüm kontrolüne eklenmez, izni 600 olmalıdır.

NODE_ENV=production
PORT=8080
APP_URL=https://portal.byelmas.com
TRUST_PROXY=true

# --- Veritabanı (PostgreSQL 14+) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=byelmas_portal
DB_USER=byelmas_portal
DB_PASSWORD=BURAYA_GUCLU_PAROLA
DB_SSL=false

# --- Kimlik doğrulama ---
# 'ldap' -> gerçek Active Directory (üretimde zorunlu). 'mock' yalnızca geliştirme/test.
AUTH_MODE=ldap
LDAP_URL=ldaps://dc01.byelmas.local:636
LDAP_BASE_DN=DC=byelmas,DC=local
LDAP_BIND_DN=CN=svc-portal,OU=ServisHesaplari,DC=byelmas,DC=local
# Servis hesabı parolası .env'e YAZILMAZ — uygulama açıldıktan sonra
# Admin Panel > Dizin (AD) Ayarları ekranından girilir, şifreli saklanır.

# --- Oturum ---
SESSION_COOKIE=tp_sid
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_MIN=600
LOGIN_MAX_ATTEMPTS=8

# SMTP/AD parolalarını veritabanında şifrelemek için 32 bayt base64 anahtar:
#   openssl rand -base64 32
# Bu anahtar kaybolursa kayıtlı parolalar çözülemez, ekrandan yeniden girilir.
APP_ENCRYPTION_KEY=BURAYA_32_BAYT_BASE64_ANAHTAR

# --- Dosya yükleme ---
UPLOAD_DIR=/var/lib/byelmas-portal/uploads
UPLOAD_MAX_MB=25

# Kurumsal ağ (BYELMAS domain) kısıtlaması: yalnızca bu IP aralıklarından erişime
# izin verilir (VPN/şirket içi ağ CIDR'leri, virgülle ayrılmış). Bir web
# sunucusu istemcinin gerçekten AD domainine üye olup olmadığını doğrudan
# doğrulayamaz (bu Kerberos/NTLM entegre kimlik doğrulaması gerektirir); bu
# ayar onun pratik eşdeğeridir: kurumsal ağın IP aralığı. Boş bırakılırsa
# (varsayılan, geliştirme/test) kısıtlama uygulanmaz — ÜRETİMDE MUTLAKA
# DOLDURULMALIDIR.
# Örnek: NETWORK_ALLOWED_CIDRS=10.20.0.0/16,192.168.50.0/24
NETWORK_ALLOWED_CIDRS=

# --- İş kuralları ---
READING_SECONDS_PER_PAGE=30
QUIZ_PASS_SCORE=70
