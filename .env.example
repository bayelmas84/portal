# ---------------------------------------------------------------------------
# Tera Portal yapılandırması
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası asla sürüm kontrolüne eklenmez, izni 600 olmalıdır.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8080
APP_URL=https://portal.terayatirim.com.tr
TRUST_PROXY=true

# --- Veritabanı (PostgreSQL 14+) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tera_portal
DB_USER=tera_portal
DB_PASSWORD=BURAYA_GUCLU_PAROLA
DB_SSL=false
# Göçleri şema sahibi ayrı hesapla çalıştırmak için (önerilir; KURULUM.md 4.1).
# Uygulama bu hesabı kullanmaz, yalnızca "npm run migrate" ve "npm run seed" kullanır.
#MIGRATION_DB_USER=tera_portal_owner
#MIGRATION_DB_PASSWORD=BURAYA_AYRI_GUCLU_PAROLA

# --- Active Directory (LDAPS zorunlu) ---
LDAP_URL=ldaps://dc01.tera.local:636
LDAP_BASE_DN=DC=tera,DC=local
LDAP_BIND_DN=CN=svc-portal,OU=ServisHesaplari,DC=tera,DC=local
LDAP_BIND_PASSWORD=BURAYA_SERVIS_HESABI_PAROLASI
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Oturum ve CSRF ---
SESSION_COOKIE=tp_sid
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_MIN=600
# 32+ karakter rastgele değer: openssl rand -base64 48
CSRF_SECRET=BURAYA_RASTGELE_EN_AZ_32_KARAKTER
# Veritabanında saklanan sırları (SMTP parolası) şifreler. 32 bayt base64:
#   openssl rand -base64 32
# Bu anahtar kaybolursa kayıtlı SMTP parolası çözülemez, ekrandan yeniden girilir.
APP_ENCRYPTION_KEY=BURAYA_32_BAYT_BASE64_ANAHTAR

# --- Dosya yükleme ---
UPLOAD_DIR=/var/lib/tera-portal/uploads
UPLOAD_MAX_MB=25

# --- E-posta (İSTEĞE BAĞLI) ---
# E-posta ayarları normalde Admin Panel > E-posta ayarları ekranından girilir.
# Aşağıdaki değerler yalnızca ekran ayarı henüz yapılmamışken yedek olarak kullanılır.
# Ekrandan "Bu ayarları kullan" işaretlendiğinde buradaki değerler devre dışı kalır.
#SMTP_HOST=smtp.tera.local
#SMTP_PORT=587
MAIL_FROM=portal@terayatirim.com.tr
MAIL_DOMAIN=terayatirim.com.tr
MAIL_GROUP_INSPECTION=teftis-kurulu@terayatirim.com.tr
MAIL_GROUP_ALL=tum-personel@terayatirim.com.tr

# --- BI servisi (Raporlar modülü) ---
# Rapor motoru ayrı serviste (PRISMA) çalışır. Portal kimliği imzalı, 60 saniye geçerli
# bir anahtarla devreder. Adres tanımlı değilse rapor açma düğmesi uyarı verir.
#BI_BASE_URL=https://prisma.terayatirim.com.tr

# --- İş kuralları ---
READING_SECONDS_PER_PAGE=30
# Yayına giren dokümanın okunması için tanınan gün sayısı
READING_DUE_DAYS=30
QUIZ_PASS_SCORE=70
LOGIN_MAX_ATTEMPTS=5
