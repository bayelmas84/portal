{
  "name": "tera-portal",
  "version": "1.11.0",
  "private": true,
  "description": "Tera Yatırım kurumsal portal - duyuru, kontrollü doküman, zorunlu okuma, onay akışı",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "migrate": "node server/src/lib/migrate.js",
    "seed": "node server/src/lib/seed.js",
    "test": "node --test --test-force-exit --test-concurrency=1 \"tests/*.test.js\"",
    "test:security": "node --test --test-force-exit tests/security.test.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ldapts": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qs": "^6.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0"
  }
}
